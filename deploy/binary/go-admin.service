# Go Admin API 服务(systemd 托管)。
# 安装:cp go-admin.service /etc/systemd/system/ && systemctl daemon-reload
# 启动:systemctl enable --now go-admin
# 以非 root 用户 goadmin 运行(README 安装步骤会创建),监听 127.0.0.1:8080,由 Nginx 反代对外。
[Unit]
Description=Go Admin API
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=goadmin
Group=goadmin
WorkingDirectory=/opt/go-admin
ExecStart=/opt/go-admin/go-admin -config /opt/go-admin/config.yaml
Restart=on-failure
RestartSec=3

# 加固:最小权限运行
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/go-admin

[Install]
WantedBy=multi-user.target
